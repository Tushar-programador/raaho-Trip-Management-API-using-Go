# Local development defaults only. Copy to .env (git-ignored) and adjust.
# Never put real credentials in this file.

# --- Docker Compose ---------------------------------------------------------
POSTGRES_USER=trips
POSTGRES_PASSWORD=trips
POSTGRES_DB=trips
# Host ports; change these if 5432/8080 are already in use on your machine.
POSTGRES_PORT=5432
API_PORT=8080

# --- API (when running on the host with `make run`) -------------------------
DATABASE_URL=postgres://trips:trips@localhost:5432/trips?sslmode=disable
HTTP_ADDR=:8080
LOG_FORMAT=text
LOG_LEVEL=info

# Optional tuning (defaults shown)
# HTTP_READ_HEADER_TIMEOUT=5s
# HTTP_READ_TIMEOUT=10s
# HTTP_WRITE_TIMEOUT=15s
# HTTP_IDLE_TIMEOUT=60s
# REQUEST_TIMEOUT=10s
# SHUTDOWN_TIMEOUT=20s
# SHUTDOWN_DRAIN_DELAY=0s   # e.g. 5s behind a load balancer
# MAX_BODY_BYTES=65536
# DB_MAX_CONNS=10
# DB_CONNECT_TIMEOUT=30s
# DB_STATEMENT_TIMEOUT=5s
# DB_LOCK_TIMEOUT=2s
# IDEMPOTENCY_TTL=24h

# --- Tests --------------------------------------------------------------------
# Integration tests TRUNCATE tables: always use a dedicated database.
TEST_DATABASE_URL=postgres://trips:trips@localhost:5432/trips_test?sslmode=disable
